# Energy Atlas — environment template.
# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored. Never commit a real key. Placeholders only here.

# ── AI provider ────────────────────────────────────────────────────────
# "google" (default, uses Gemini) or "ollama" (local dev).
AI_PROVIDER=google

# Google AI Studio key — required when AI_PROVIDER=google.
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Cap on daily LLM calls (defaults to 500 if unset). Leaves headroom
# under the Google AI Studio free-tier quota.
MAX_DAILY_LLM_CALLS=500

# ── Local LLM (optional, only when AI_PROVIDER=ollama) ──────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ── Rate limiting (optional but recommended for production) ─────────────
# Free Redis at https://console.upstash.com — leave blank to disable
# rate limiting in local dev (the app no-ops gracefully).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Demo mode (optional) ────────────────────────────────────────────────
# When true, every LLM endpoint returns a pre-recorded fixture with
# simulated latency — zero network calls. Both flags must agree.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Secret that enables the runtime demo/live toggle in the header.
# Min 16 chars. Leave unset to disable the toggle endpoints.
# ADMIN_SECRET=
